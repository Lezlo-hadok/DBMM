<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DBMM_1.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DBMM_1"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="DBB">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="#EAF4FF" Margin="20">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="60" />
            <!-- Main Grid -->
            <RowDefinition Height="*" />
            <!-- Footer -->
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>
        <!-- Header -->
            <Border Grid.Row="0"
                Margin="5">
            <TextBlock Text="Dodgy Brothers Motor Management"
                       FontSize="36"
                       FontWeight="Bold"
                       FontStyle="Italic"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center" />
        </Border>
            <!-- Main Grid 3x3 -->
        <Border Grid.Row="1" Margin="5">
            <Grid Margin="10" Background="#5F5F5F">
                <!-- Grid layout -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                 
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                
                <!-- Cell 1-1 Customer information and Car price -->
                <Grid Grid.Row="0" Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                   
                    <TextBox x:Name="customerNameTextBox"  Grid.Row="0" 
                             Margin="5"
                             PlaceholderText="Customer Name"
                             VerticalAlignment="Center"/>
                    
                    <TextBox x:Name ="phoneTextBox" Grid.Row="1" Grid.Column="1"
                             Margin="5"
                             PlaceholderText="Phone Number"
                             VerticalAlignment="Center"/>
                    
                    <TextBox x:Name = "vehiclePriceTextBox"  Grid.Row="2" Grid.Column="1"
                             Margin="5"
                             PlaceholderText="Vehicle Price"
                             VerticalAlignment="Center"/>
                    
                    <TextBox x:Name="tradeInTextBox" Grid.Row="3" Grid.Column="1"
                             PlaceholderText="Trade In Value"
                             Margin="5"
                             VerticalAlignment="Center"/>
                    
                </Grid>



                <!-- Cell 1-2 Car Image -->
                <StackPanel Grid.Row="0" Grid.Column="1"
                            HorizontalAlignment="Center">
                    <Image Source="/Assets/car_image.jpg"
                          Width="350"
                          Height="210"
                          Stretch="Fill"/>
                    
                </StackPanel>
                
                <!-- Cell 1-3 Warrenty -->
                <StackPanel Grid.Row="0" Grid.Column="2">
                    <CheckBox Foreground="White">
                        Window Tinting $150
                    </CheckBox>
                    <CheckBox Foreground="White">
                        Duco Protection $180
                    </CheckBox>
                    <CheckBox Foreground="White">
                        Floor Mats $320
                    </CheckBox>
                    <CheckBox Foreground="White">
                        Deluxe Sound System $350
                    </CheckBox>
                </StackPanel>
                
                
                
                <!-- Cell 2-1 Calculations -->
                <Grid Grid.Row="1" Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    
                    
                    <TextBox  x:Name="subAmountTextBox" Grid.Row="0" Grid.Column="1"
                             Margin="5"
                              PlaceholderText="SUB AMOUNT"
                             VerticalAlignment="Center"/>
                    
                    <TextBox  x:Name="gstAmountTextBox" Grid.Row="1" Grid.Column="1"
                             Margin="5"
                              PlaceholderText="GST AMOUNT"
                             VerticalAlignment="Center"/>
                    
                    <TextBox  x:Name="finalAmountTextBox" Grid.Row="2" Grid.Column="1"
                             Margin="5"
                             PlaceholderText="FINAL AMOUNT"
                             VerticalAlignment="Center"/>
                </Grid>
                <!-- Cell 2-2 Buttons -->
                <StackPanel Grid.Row="1" Grid.Column="1"
                            HorizontalAlignment="Center">
                    <Button Content="SUMMARY"
                            Width="350"
                            Height="40"
                            Margin="5"
                            Background="#0078D7"
                            Foreground="White"
                            Click="summaryButton_Click"/>
                    
                    <Button Content="SAVE"
                            Width="350"
                            Height="40"
                            Margin="5"
                            Background="#0078D7"
                            Foreground="White"
                            Click="saveButton_Click"/>
                    
                    <Button Content="RESET"
                            Width="350"
                            Height="40"
                            Margin="5"
                            Background="#0078D7"
                            Foreground="White"
                            Click="resetButton_Click"/>
                    
                </StackPanel>
                
                <!-- Cell 2-3 Insurance-->
                <StackPanel Grid.Row="1" Grid.Column="2">
                    <ToggleSwitch
                        Header="Insurance"
                        />
                    <RadioButton Foreground="White">
                        drivers under age 25 may purchase 1 year insurance for 20% of vehicle price
                    </RadioButton>
                    <RadioButton Foreground="White">
                            older drivers (>=25) may purchase for 10% of vehicle price
                    </RadioButton>

                </StackPanel>
                
                
                <!--Cell 3-1 Warranty-->
                <StackPanel Grid.Row="2" Grid.Column="0">
                    <ComboBox Header="Warranty" Height="70" Width="500" Foreground="White" PlaceholderText="1 year warranty minimum">
                        <ComboBoxItem>1 year warranty has no charge</ComboBoxItem>
                        <ComboBoxItem>2 years at 5% of vehicle cost</ComboBoxItem>
                        <ComboBoxItem>3 years at 10% of vehicle cost</ComboBoxItem>
                        <ComboBoxItem>5 years at 20% of vehicle cost</ComboBoxItem>
                    </ComboBox>
                </StackPanel>
                
                
                <!-- Cell 3-2 Summary Box-->
                <StackPanel Grid.Column="1" Grid.Row="2">
                    <StackPanel Margin="5" Height="400" Width="400" Background="#d3d3d3">
                        <TextBlock Height="400"
                           Width="400"
                           x:Name="summaryTextBlock"
                           Foreground="Black"
                           TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
                
                <!-- Cell 3-3 Collection and pickup date-->
                <Grid Grid.Row="2" Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Date of Collection" Grid.Column="0"/>

                    <DatePicker Grid.Row="1" Grid.Column="0"
                         Margin="5"
                          
                         VerticalAlignment="Center"/>

                    <TextBlock Text="Collection Time" Grid.Row="2"/>
                    <TimePicker Grid.Row="3" Grid.Column="1"
                         Margin="5"
                          
                         VerticalAlignment="Center"/>

                </Grid>
                
                
            </Grid>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="2"
                Margin ="5">
            <TextBlock Text="IT WORKS: Benjamin Semler"
                       FontSize="14"
                       VerticalAlignment="Top"
                       HorizontalAlignment="Right" />
        </Border>
    </Grid>
</Window>
